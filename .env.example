# Copy to .env and fill in. .env is git-ignored.
# Get a key at https://aistudio.google.com/
GOOGLE_API_KEY=
# Optional: override the Gemini model (default: DEFAULT_MODEL in rag/src_rag/llm/gemini.py).
GEMINI_MODEL=
# Optional: minimum seconds between real API calls, to stay under a requests-per-minute limit.
# The free tier of gemini-3.5-flash allows 5 per minute, so 12 avoids errors during a demo.
GEMINI_MIN_INTERVAL_S=
# Optional: set to 1 to let `make test` call the real API (tests/llm/test_gemini.py).
LLM_LIVE_TESTS=
